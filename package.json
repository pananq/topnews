{
  "name": "global-news-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/copy-data.mjs",
    "test": "vitest run",
    "generate": "node --import tsx/esm scripts/generate-news.ts",
    "validate:data": "node --import tsx/esm scripts/validate-data.ts"
  },
  "dependencies": {
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "jsdom": "^24.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
